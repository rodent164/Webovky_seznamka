# Copy this file to .env. Never commit .env or expose the secret key in browser code.
STRIPE_SECRET_KEY=sk_test_replace_with_your_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_cli_secret
SITE_URL=http://localhost:4242
PORT=4242
# Whole Czech crowns; the server converts this to haléře for Stripe.
EVENT_PRICE_CZK=500
# Local SQLite database used while developing. Keep it outside version control.
DATABASE_PATH=./data/registrations.db
